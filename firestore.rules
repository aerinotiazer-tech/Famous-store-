rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isValidEmailId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-+@\\.]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() 
        && request.auth.token.email != null 
        && (
          request.auth.token.email.lower() == 'aerinotiazer@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
        );
    }
    
    // --- Validation: Product ---
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'condition', 'batteryHealth', 'storage', 'imageUrl', 'category', 'isNew', 'createdAt', 'updatedAt'])
      && data.keys().size() == 10
      && data.name is string && data.name.size() > 0 && data.name.size() <= 150
      && data.price is number && data.price >= 0
      && data.condition is string && data.condition.size() <= 20
      && data.batteryHealth is number && data.batteryHealth >= 0 && data.batteryHealth <= 100
      && data.storage is string && data.storage.size() <= 40
      && data.imageUrl is string && data.imageUrl.size() <= 2500000
      && data.category is string && data.category.size() <= 50
      && data.isNew is bool
      && data.createdAt is string && data.createdAt.size() <= 50
      && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // --- Validation: Inquiry ---
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'phone', 'message', 'productId', 'status', 'createdAt'])
      && data.keys().size() == 6
      && data.name is string && data.name.size() > 0 && data.name.size() <= 100
      && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30
      && data.message is string && data.message.size() <= 2000
      && data.productId is string && data.productId.size() <= 128
      && data.status is string && data.status.size() <= 20
      && data.createdAt is timestamp;
    }

    // --- Validation: Admin ---
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'createdAt'])
      && data.keys().size() == 2
      && data.email is string && data.email.size() > 0 && data.email.size() <= 100
      && data.createdAt is string && data.createdAt.size() <= 100;
    }

    // --- Rules ---
    match /products/{productId} {
      allow read: if true;
 
      // Only admins can write
      allow create: if isValidId(productId) && isAdmin() 
        && isValidProduct(incoming());
        
      allow update: if isValidId(productId) && isAdmin()
        && isValidProduct(incoming())
        && incoming().createdAt == existing().createdAt;
 
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin(); // only admins need to list

      // Anyone can create an inquiry
      allow create: if isValidId(inquiryId) 
        && isValidInquiry(incoming())
        && incoming().createdAt == request.time
        && incoming().status == 'new'
        // Ensure product exists (using exists on the path)
        && exists(/databases/$(database)/documents/products/$(incoming().productId));
        
      allow update: if isValidId(inquiryId) && isAdmin()
        && isValidInquiry(incoming())
        && incoming().createdAt == existing().createdAt;
        
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{emailId} {
      // Allows an admin to check their own role or other roles, and anyone to check if they are admin.
      allow get: if isValidEmailId(emailId) && isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == emailId.lower()) 
        || isAdmin()
      );
      allow list: if isAdmin();
      
      // Bootstrap: Allow creation of 'aerinotiazer@gmail.com' or admin can add others
      allow create: if isValidEmailId(emailId) && isSignedIn() && (
        isAdmin() || 
        (emailId.lower() == 'aerinotiazer@gmail.com' && request.auth.token.email != null && request.auth.token.email.lower() == 'aerinotiazer@gmail.com')
      ) && isValidAdmin(incoming());
      
      allow update: if false; // Admins roles cannot be updated, delete and recreate
      allow delete: if isValidEmailId(emailId) && isAdmin() && emailId.lower() != 'aerinotiazer@gmail.com'; // Cannot delete master
    }
  }
}
